cabal-version:   3.0
name:            diagrams-canvas-json-cairo
version:         0.1.0.0
synopsis:
  Render diagrams-canvas-json output to PNG/SVG/JPEG images via gi-cairo

-- description:
license:         MIT
license-file:    LICENSE
author:          Handré Stolp
maintainer:      HanStolpo@gmail.com

-- copyright:
category:        Graphics
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Diagrams.Backend.CanvasJson.Cairo
    Diagrams.Backend.CanvasJson.MaskPng
    Diagrams.Backend.CanvasJson.MaskRaster

  build-depends:
    , array
    , base                  >=4.20 && <4.22
    , bytestring
    , containers
    , diagrams-canvas-json
    , filepath
    , gi-cairo-render
    , JuicyPixels
    , mtl
    , text
    , zlib                  >=0.7  && <0.8

  hs-source-dirs:   src
  default-language: GHC2021

executable diagrams-canvas-json-cairo
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , aeson
    , base                        >=4.20 && <4.22
    , bytestring
    , diagrams-canvas-json
    , diagrams-canvas-json-cairo
    , optparse-applicative

  hs-source-dirs:   exe
  default-language: GHC2021

test-suite diagrams-canvas-json-cairo-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    , aeson
    , base                        >=4.20 && <4.22
    , bytestring
    , containers
    , diagrams-canvas-json
    , diagrams-canvas-json-cairo
    , directory
    , gi-cairo-render
    , JuicyPixels
    , tasty
    , tasty-hunit

  hs-source-dirs:   test
  default-language: GHC2021
