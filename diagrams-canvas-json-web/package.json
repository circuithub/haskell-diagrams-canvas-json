{
  "name": "diagrams-canvas-json-web",
  "version": "0.1.0",
  "description": "TypeScript library for rendering diagrams-canvas-json output using HTML Canvas",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pixi": {
      "import": "./dist/pixi.js",
      "types": "./dist/pixi.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc",
    "build:bundle": "vite build --config vite.lib.config.ts",
    "build:bundle-pixi": "vite build --config vite.pixi.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "test:browser": "bun test/browser/run.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "author": "Handré Stolp",
  "license": "MIT",
  "dependencies": {
    "pixi.js": "^8.17.1"
  }
}
